# Template variabel environment production untuk docker-compose.prod.yml.
# Salin jadi prod.env di folder yang sama, isi semua nilai, jangan commit aslinya.

# ==== Aplikasi ====
# Ditimpa oleh compose: APP_ENV=production, DB_HOST=mysql, REDIS_ADDR=redis:6379.
# Baris di bawah tetap ditulis untuk keamanan kalau dijalankan di luar compose.
APP_ENV=production
APP_PORT=8080

# Origin frontend yang diizinkan CORS. Beberapa origin dipisah koma.
FRONTEND_URL=https://kawahputih.example.com

# URL publik backend untuk webhook Midtrans. WAJIB https dan bisa diakses internet.
BACKEND_PUBLIC_URL=https://api.kawahputih.example.com

# ==== Keamanan ====
# Buat nilai acak yang panjang, misal: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7
JWT_ISSUER=KawahPutih

# ==== Database (MySQL di dalam compose) ====
MYSQL_ROOT_PASSWORD=
DB_HOST=mysql
DB_PORT=3306
DB_USER=kawahputih
DB_PASSWORD=
DB_NAME=kawah_putih_db
DB_MAX_OPEN_CONNS=50
DB_MAX_IDLE_CONNS=10

# Catatan: user DB di atas dibuat manual kalau bukan root. Cara termudah
# untuk produksi kecil: pakai root (DB_USER=root) karena MYSQL_ROOT_PASSWORD
# sudah diset di file ini. Buat akun khusus bila servernya dipakai bersama.

# ==== Redis ====
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# ==== Midtrans ====
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=true

# ==== SMTP ====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@kawahputih.id

# ==== Google OAuth (opsional) ====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.kawahputih.example.com/api/v1/auth/google/callback

# ==== Seed staff (opsional) ====
# Isi hanya kalau mau membuat akun awal. Kosong = tidak dibuat.
# Wajib unik dan kuat, jangan pakai contoh ini langsung.
SEED_SUPERADMIN_PASSWORD=
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_PETUGAS_PASSWORD=
